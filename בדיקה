import tkinter as tk  # מייבא את ספריית tkinter ליצירת ממשק משתמש גרפי (GUI)

class MainDashboardGUI:  # מגדיר את המחלקה הראשית לניהול מסך לוח הבקרה (Dashboard) של המערכת
    def __init__(self, root, username="מנהל", role="Admin"):  # בנאי המחלקה המקבל את חלון ה-Tkinter, שם משתמש ותפקיד
        self.root = root  # שומר את אובייקט החלון הראשי כמשתנה של המופע
        self.root.title("ENC SECURE CAM - Home")  # מגדיר את כותרת החלון המוצגת בסרגל העליון
        self.root.geometry("700x950")  # קובע את מידות החלון: רוחב 700 פיקסלים וגובה 950 פיקסלים
        self.root.resizable(False, False)  # נועל את החלון ומונע שינוי גודל על ידי המשתמש
        
        # פלטת צבעים תואמת למסך ה-Login ולהדמיה
        self.bg_blue = "#1f4e78"       # צבע רקע כחול כהה/מודרני עבור החלון הראשי וגוף המסך
        self.header_bg = "#ffffff"     # צבע רקע לבן עבור הסרגל העליון וסרגל הניווט התחתון
        self.card_bg = "#ffffff"       # צבע רקע לבן עבור כרטיסי הפעולות
        self.card_hover = "#f0f6fc"    # גוון כחלחל-בהיר עדין בעת מעבר סמן העכבר (ריחוף) מעל כרטיס
        self.accent_blue = "#0a61c7"   # צבע כחול דגש של המערכת לאלמנטים פעילים וכפתורים
        self.text_dark = "#1a202c"     # צבע טקסט כהה עבור כותרות וטקסטים ראשיים
        self.text_gray = "#64748b"     # צבע טקסט אפור עבור כותרות משנה וטקסטים משניים

        self.username = username  # שומר את שם המשתמש המחובר כמשתנה מופע
        self.role = role  # שומר את הרשאת/תפקיד המשתמש כמשתנה מופע

        self.root.configure(bg=self.bg_blue)  # מגדיר את צבע הרקע של החלון הראשי לצבע הכחול הכהה
        self.setup_ui()  # קורא לפונקציה המגדירה ובונה את כל רכיבי ממשק המשתמש (UI)

    def setup_ui(self):  # פונקציה לבנייה וסידור כל רכיבי הממשק הגרפי במסך
        # --- 1. סרגל עליון (Header) ---
        header = tk.Frame(self.root, bg=self.header_bg, height=110)  # יוצר מסגרת (Frame) עבור הסרגל העליון בגובה 110 פיקסלים
        header.pack(fill="x", side="top")  # מציב את הסרגל העליון בחלקו העליון של המסך ומותח אותו לכל הרוחב
        header.pack_propagate(False)  # מונע מהסרגל העליון להתכווץ או לשנות את גובהו הקבוע בהתאם לרכיבים שבתוכו

        # צד שמאל: כותרת המסך
        title_lbl = tk.Label(  # יוצר תווית טקסט עבור כותרת המסך
            header, text="Home בית", font=("Segoe UI", 22, "bold"),  # מגדיר את הטקסט "Home בית" בגופן Segoe UI מודגש
            bg=self.header_bg, fg=self.text_dark  # מגדיר רקע לבן וטקסט כהה
        )
        title_lbl.pack(side="left", padx=25)  # מצמיד את הכותרת לצד שמאל עם מרווח אופקי של 25 פיקסלים

        # מרכז: לוגו המערכת (סמל מגן ומצלמה)
        logo_canvas = tk.Canvas(header, width=65, height=75, bg=self.header_bg, highlightthickness=0)  # יוצר משטח ציור קטן עבור הלוגו במרכז הסרגל
        logo_canvas.pack(side="left", expand=True)  # ממקם את משטח הציור במרכז הסרגל העליון באמצעות מתיחה (expand)
        self.draw_shield_logo(logo_canvas)  # קורא לפונקציה המציירת את סמל המגן והמצלמה על גבי ה-Canvas

        # צד ימין: פרטי משתמש וכפתור התנתקות
        user_frame = tk.Frame(header, bg=self.header_bg)  # יוצר מסגרת פנימית בצד ימין עבור פרטי המשתמש וכפתור היציאה
        user_frame.pack(side="right", padx=25)  # מצמיד את המסגרת לצד ימין של הסרגל עם מרווח אופקי של 25 פיקסלים

        user_lbl = tk.Label(  # יוצר תווית המציגה את שם המשתמש המחובר עם אייקון
            user_frame, text=f"👤 מחובר: {self.username}",  # מציג את שם המשתמש הדינמי שהועבר לבנאי
            font=("Segoe UI", 12, "bold"), bg=self.header_bg, fg=self.text_dark  # מגדיר גופן מודגש, רקע לבן וטקסט כהה
        )
        user_lbl.pack(anchor="e", pady=(0, 6))  # מיישר את תווית המשתמש לימין (מזרח) עם מרווח תחתון של 6 פיקסלים

        logout_btn = tk.Button(  # יוצר כפתור מעוצב להתנתקות מהמערכת
            user_frame, text="Logout ↪", font=("Segoe UI", 10, "bold"),  # מגדיר את טקסט הכפתור "Logout ↪" בגופן מודגש
            bg="#eef4fb", fg=self.accent_blue, relief="flat", cursor="hand2",  # קובע רקע תכלת עדין, טקסט כחול, עיצוב שטוח וסמן יד
            padx=12, pady=3, command=lambda: self.on_click("Logout")  # מוסיף ריפוד פנימי ומחבר לחיצה להפעלת פונקציית הלחיצה
        )
        logout_btn.pack(anchor="e")  # מיישר את כפתור ההתנתקות לצד ימין מתחת לתווית המשתמש

        # --- 2. גוף המסך המרכזי (רשת 2x2 של כרטיסי הפרויקט) ---
        main_container = tk.Frame(self.root, bg=self.bg_blue)  # יוצר מסגרת מרכזית עבור גוף המסך שתכיל את כרטיסי המערכת
        main_container.pack(fill="both", expand=True, padx=35, pady=40)  # מותח את המסגרת לכל השטח הפנוי עם מרווחים חיצוניים

        # הגדרת משקל שווה לעמודות ולשורות
        main_container.columnconfigure(0, weight=1, uniform="col")  # מקצה משקל שווה וחלוקה אחידה לעמודה 0 ברשת
        main_container.columnconfigure(1, weight=1, uniform="col")  # מקצה משקל שווה וחלוקה אחידה לעמודה 1 ברשת
        main_container.rowconfigure(0, weight=1, uniform="row")  # מקצה משקל שווה וחלוקה אחידה לשורה 0 ברשת
        main_container.rowconfigure(1, weight=1, uniform="row")  # מקצה משקל שווה וחלוקה אחידה לשורה 1 ברשת

        # יצירת 4 הכרטיסים לפי המיקום בהדמיה
        self.create_feature_card(  # יוצר כרטיס ראשון (שמאל למעלה): חיפוש וסינון מתקדם
            parent=main_container, row=0, col=0,  # מיקום ברשת: שורה 0, עמודה 0
            icon="📅🔍", title_he="חיפוש וסינון מתקדם",  # אייקון יומן וזכוכית מגדלת, וכותרת בעברית
            title_en="Advanced Search\n& Filter", action_name="Search & Filter"  # כותרת באנגלית ושם הפעולה
        )
        self.create_feature_card(  # יוצר כרטיס שני (ימין למעלה): פעולות מצלמה
            parent=main_container, row=0, col=1,  # מיקום ברשת: שורה 0, עמודה 1
            icon="📹", title_he="פעולות מצלמה",  # אייקון מצלמת וידאו וכותרת בעברית
            title_en="Camera Operations", action_name="Camera Operations"  # כותרת באנגלית ושם הפעולה
        )
        self.create_feature_card(  # יוצר כרטיס שלישי (שמאל למטה): יומן אבטחה מוגן
            parent=main_container, row=1, col=0,  # מיקום ברשת: שורה 1, עמודה 0
            icon="🛡️🔒", title_he="יומן אבטחה מוגן",  # אייקון מגן ומנעול, וכותרת בעברית
            title_en="Security Logs", action_name="Security Logs"  # כותרת באנגלית ושם הפעולה
        )
        self.create_feature_card(  # יוצר כרטיס רביעי (ימין למטה): צילומים מוצפנים
            parent=main_container, row=1, col=1,  # מיקום ברשת: שורה 1, עמודה 1
            icon="📁🔒", title_he="צילומים מוצפנים",  # אייקון תיקייה ומנעול, וכותרת בעברית
            title_en="Encrypted Recordings", action_name="Encrypted Recordings"  # כותרת באנגלית ושם הפעולה
        )

        # --- 3. סרגל ניווט תחתון (Bottom Navigation Bar) ---
        bottom_bar = tk.Frame(self.root, bg=self.header_bg, height=85)  # יוצר מסגרת עבור סרגל הניווט התחתון בגובה 85 פיקסלים
        bottom_bar.pack(fill="x", side="bottom")  # מצמיד את הסרגל לתחתית המסך ומותח אותו לכל הרוחב
        bottom_bar.pack_propagate(False)  # מונע מהסרגל התחתון להתכווץ או לשנות את גובהו הקבוע

        nav_items = [  # רשימת הטאבים בסרגל הניווט התחתון: (אייקון, שם הטאב, האם הטאב פעיל כרגע)
            ("👤", "פרופיל", False),  # טאב פרופיל משתמש (לא פעיל)
            ("🔔", "התראות", False),  # טאב התראות מערכת (לא פעיל)
            ("⚙️", "הגדרות", False),  # טאב הגדרות מערכת (לא פעיל)
            ("🏠", "בית", True)  # טאב מסך הבית (פעיל כעת כברירת מחדל)
        ]

        for icon, label_text, is_active in nav_items:  # לולאה העוברת על כל אחד מפריטי הניווט בסרגל
            color = self.accent_blue if is_active else self.text_gray  # קובע צבע כחול דגש לטאב הפעיל, ואפור לטאב שאינו פעיל
            tab = tk.Frame(bottom_bar, bg=self.header_bg, cursor="hand2")  # יוצר מסגרת לכל טאב עם רקע לבן וסמן עכבר בצורת יד
            tab.pack(side="left", fill="both", expand=True)  # מציב את הטאב ומחלק את רוחב הסרגל התחתון באופן שווה בין כל הטאבים

            icon_lbl = tk.Label(tab, text=icon, font=("Segoe UI", 18), bg=self.header_bg, fg=color)  # יוצר תווית להצגת אייקון הטאב
            icon_lbl.pack(pady=(12, 2))  # ממקם את האייקון עם מרווח עליון ותחתון קל

            txt_lbl = tk.Label(tab, text=label_text, font=("Segoe UI", 11, "bold" if is_active else "normal"), bg=self.header_bg, fg=color)  # יוצר תווית טקסט לשם הטאב (מודגש אם פעיל)
            txt_lbl.pack()  # ממקם את תווית הטקסט מתחת לאייקון

            # חיבור קליק דמה לכל אלמנט בטאב
            for widget in (tab, icon_lbl, txt_lbl):  # לולאה המחברת את אירוע הלחיצה לכל הרכיבים בתוך הטאב (המסגרת, האייקון והטקסט)
                widget.bind("<Button-1>", lambda e, name=label_text: self.on_click(f"Tab: {name}"))  # מחבר לחיצת עכבר שמאלית לפונקציית הלחיצה עם שם הטאב

    def draw_shield_logo(self, canvas):  # פונקציה לציור גרפי של לוגו המגן ועדשת המצלמה במרכז הסרגל העליון
        """מצייר את סמל המגן הכחול עם עדשת מצלמה במרכז"""
        # צורת מגן חיצונית
        shield_pts = [32, 5, 58, 15, 55, 45, 32, 68, 9, 45, 6, 15]  # רשימת קואורדינטות (X, Y) המגדירות את נקודות צורת המגן
        canvas.create_polygon(shield_pts, fill=self.accent_blue, outline="#084298", width=2, smooth=True)  # מצייר מצולע מוחלק של מגן כחול עם קו מתאר כהה
        # עיגול עדשת מצלמה פנימי
        canvas.create_oval(20, 23, 44, 47, fill="#ffffff", outline="#084298", width=2)  # מצייר את הטבעת הלבנה החיצונית של עדשת המצלמה
        canvas.create_oval(26, 29, 38, 41, fill="#1a202c", outline="")  # מצייר את העיגול הכהה המרכזי של עדשת המצלמה
        canvas.create_oval(29, 31, 32, 34, fill="#ffffff", outline="") # השתקפות אור בעדשה  # מצייר נקודה לבנה קטנה המדמה השתקפות אור (ברק) בעדשה

    def create_feature_card(self, parent, row, col, icon, title_he, title_en, action_name):  # פונקציה ליצירת כרטיס פעולה מעוצב בלוח הבקרה
        """יוצר כרטיס פיצ'ר מעוצב עם אפקט ריחוף"""
        card = tk.Frame(  # יוצר את מסגרת הכרטיס הראשית
            parent, bg=self.card_bg, cursor="hand2",  # קובע רקע לבן וסמן עכבר בצורת יד בלחיצה
            highlightbackground="#d0e1f9", highlightthickness=2  # מוסיף מסגרת דקה בגוון תכלת בעובי 2 פיקסלים
        )
        card.grid(row=row, column=col, padx=16, pady=16, sticky="nsew")  # ממקם את הכרטיס במיקום שנקבע ברשת עם מרווחים ומתיחה לכל הכיוונים

        # מרכז התוכן בתוך הכרטיס
        inner = tk.Frame(card, bg=self.card_bg)  # יוצר מסגרת פנימית המרכזת את כל תוכן הכרטיס
        inner.place(relx=0.5, rely=0.5, anchor="center")  # ממקם את המסגרת הפנימית בדיוק במרכז הגיאומטרי של הכרטיס

        icon_lbl = tk.Label(inner, text=icon, font=("Segoe UI", 42), bg=self.card_bg, fg=self.accent_blue)  # יוצר תווית להצגת האייקון הגדול של הכרטיס בגודל 42
        icon_lbl.pack(pady=(0, 15))  # מציב את תווית האייקון עם מרווח תחתון של 15 פיקסלים

        he_lbl = tk.Label(inner, text=title_he, font=("Segoe UI", 16, "bold"), bg=self.card_bg, fg=self.text_dark)  # יוצר תווית לכותרת העברית בגופן מודגש
        he_lbl.pack(pady=(0, 6))  # מציב את הכותרת העברית עם מרווח תחתון של 6 פיקסלים

        en_lbl = tk.Label(inner, text=title_en, font=("Segoe UI", 12), bg=self.card_bg, fg=self.text_gray, justify="center")  # יוצר תווית לכותרת המשנה באנגלית במרכוז
        en_lbl.pack()  # מציב את כותרת המשנה מתחת לכותרת העברית

        # אירועי ריחוף ולחיצה לכל הרכיבים בתוך הכרטיס
        all_widgets = [card, inner, icon_lbl, he_lbl, en_lbl]  # מאגד את כל רכיבי הכרטיס לרשימה לצורך החלת אירועים משותפים
        for w in all_widgets:  # עובר על כל אחד מרכיבי הכרטיס
            w.bind("<Enter>", lambda e: self.set_card_bg(all_widgets, self.card_hover))  # משנה את צבע הרקע לגוון ריחוף בהיר בעת כניסת העכבר
            w.bind("<Leave>", lambda e: self.set_card_bg(all_widgets, self.card_bg))  # מחזיר את צבע הרקע ללבן בעת יציאת סמן העכבר
            w.bind("<Button-1>", lambda e: self.on_click(action_name))  # מחבר לחיצת עכבר שמאלית להפעלת הפעולה המשויכת לכרטיס

    def set_card_bg(self, widgets, color):  # פונקציית עזר לעדכון צבע הרקע של קבוצת רכיבים בבת אחת
        for w in widgets:  # עובר בלולאה על כל הווידג'טים ברשימה
            w.configure(bg=color)  # מגדיר את צבע הרקע החדש לרכיב הנוכחי

    def on_click(self, name):  # פונקציה המטפלת בלחיצה על כרטיסים, כפתורים וטאבים בממשק
        # בשלב זה רק מדפיס לטרמינל לצורך בדיקת השלד
        print(f"[UI Skeleton] נלחץ: {name}")  # מדפיס לקונסול את שם הפעולה או הטאב שנלחץ לצורך בדיקה ומעקב


if __name__ == "__main__":  # בודק האם הקובץ מורץ ישירות כתוכנית ראשית
    root = tk.Tk()  # יוצר מופע חדש של חלון Tkinter ראשי
    app = MainDashboardGUI(root)  # יוצר מופע של מחלקת לוח הבקרה ומעביר אליו את החלון
    root.mainloop()  # מפעיל את לולאת האירועים הראשית של Tkinter להצגת החלון והמתנה לאינטראקציות משתמש
